pkgname=lunaos-native
pkgver=0.1.0
pkgrel=1
pkgdesc='Go control-plane services for LunaOS'
arch=('x86_64')
url='https://github.com/gregpavoine/LunaOS'
license=('custom')
depends=('glibc' 'systemd-libs')
makedepends=('go' 'gcc' 'make')
options=('!debug')
source=()
sha256sums=()

prepare() {
  local repository_root="$startdir/../.."
  cp -a "$repository_root/go.mod" "$repository_root/go.sum" "$repository_root/services" "$srcdir/"
  mkdir -p "$srcdir/systemd"
  cp "$repository_root/systemd/luna-core.service" "$repository_root/systemd/luna-policy-broker.service" "$srcdir/systemd/"
  mkdir -p "$srcdir/sysusers"
  cp "$repository_root/systemd-sysusers/lunaos.conf" "$srcdir/sysusers/"
  cd "$srcdir"
  go mod download
}

build() {
  cd "$srcdir"
  CGO_ENABLED=1 go build -buildvcs=false -trimpath -ldflags='-s -w' -o luna-core ./services/core/cmd/luna-core
  CGO_ENABLED=1 go build -buildvcs=false -trimpath -ldflags='-s -w' -o luna-policy-broker ./services/policy
  CGO_ENABLED=1 go build -buildvcs=false -trimpath -ldflags='-s -w' -o luna-vault ./services/intimacy/cmd/luna-vault
  CGO_ENABLED=1 go build -buildvcs=false -trimpath -ldflags='-s -w' -o luna-owner-setup ./services/identity/cmd/luna-owner-setup
}

package() {
  install -Dm755 "$srcdir/luna-core" "$pkgdir/usr/bin/luna-core"
  install -Dm755 "$srcdir/luna-policy-broker" "$pkgdir/usr/bin/luna-policy-broker"
  install -Dm755 "$srcdir/luna-vault" "$pkgdir/usr/bin/luna-vault"
  install -Dm755 "$srcdir/luna-owner-setup" "$pkgdir/usr/bin/luna-owner-setup"
  install -Dm644 "$srcdir/systemd/luna-core.service" "$pkgdir/usr/lib/systemd/system/luna-core.service"
  install -Dm644 "$srcdir/systemd/luna-policy-broker.service" "$pkgdir/usr/lib/systemd/system/luna-policy-broker.service"
  install -Dm644 "$srcdir/sysusers/lunaos.conf" "$pkgdir/usr/lib/sysusers.d/lunaos.conf"
  install -Dm644 "$startdir/lunaos.desktop" "$pkgdir/usr/share/applications/lunaos.desktop"
  install -Dm644 "$startdir/../../README.md" "$pkgdir/usr/share/doc/lunaos-native/README.md"
}
