[Unit]
Description=LunaOS owner-authenticated policy broker
Before=luna-core.service
PartOf=luna-core.service

[Service]
Type=simple
User=lunaos
Group=lunaos
RuntimeDirectory=lunaos
RuntimeDirectoryMode=0700
LoadCredential=owner-token:/etc/lunaos/owner-token
Environment=LUNA_OWNER_TOKEN_FILE=%d/owner-token
Environment=LUNA_POLICY_SOCKET=/run/lunaos/policy.sock
ExecStart=/usr/bin/luna-policy-broker
Restart=on-failure
RestartSec=2s
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
