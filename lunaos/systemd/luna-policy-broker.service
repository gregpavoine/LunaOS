[Unit]
Description=LunaOS owner-authenticated policy broker
Before=luna-core.service
Requires=luna-owner-setup.service
After=luna-owner-setup.service
PartOf=luna-core.service

[Service]
Type=simple
User=luna-policy
Group=luna-policy
RuntimeDirectory=luna-policy
RuntimeDirectoryMode=0750
LoadCredential=policy-token:/var/lib/lunaos-identity/policy-token
ExecStart=/usr/bin/luna-policy-broker --socket=/run/luna-policy/policy.sock --key-file=%d/policy-token --client-user=lunaos
Restart=on-failure
RestartSec=2s
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
