[Unit]
Description=Provision first-boot LunaOS owner and Broker credentials
Before=luna-policy-broker.service
ConditionPathExists=!/var/lib/lunaos-identity/owner-token

[Service]
Type=oneshot
StateDirectory=lunaos-identity
StateDirectoryMode=0700
StandardOutput=journal+console
StandardError=journal+console
UMask=0077
ExecStartPre=/usr/bin/sh -c 'stat -c "LunaOS credential state mode=%a owner=%u" /var/lib/lunaos-identity; test -x /usr/bin/luna-owner-setup'
ExecStart=/usr/bin/luna-owner-setup --path=/var/lib/lunaos-identity/owner-token --policy-path=/var/lib/lunaos-identity/policy-token
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/lunaos-identity
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
