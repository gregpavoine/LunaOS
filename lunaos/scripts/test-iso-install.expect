#!/usr/bin/expect -f
set timeout 7200
log_file -noappend $env(LUNAOS_INSTALL_LOG)
spawn qemu-system-x86_64 \
  -machine q35,accel=kvm:tcg -cpu max -smp 4 -m 6144 \
  -drive if=pflash,format=raw,unit=0,readonly=on,file=$env(LUNAOS_OVMF_CODE) \
  -drive if=pflash,format=raw,unit=1,file=$env(LUNAOS_OVMF_VARS) \
  -drive file=$env(LUNAOS_TARGET_DISK),if=virtio,format=qcow2 \
  -cdrom $env(LUNAOS_ISO_PATH) \
  -drive file=$env(LUNAOS_SEED_ISO),media=cdrom,if=ide,index=1,readonly=on \
  -boot order=dc -display none -serial stdio -monitor none -nic user,model=virtio-net-pci

expect {
  -re {root@[^\r\n]*[#] ?} {}
  timeout { puts stderr "FAIL: no root shell appeared on the live ISO serial console"; exit 1 }
  eof { puts stderr "FAIL: QEMU exited before the live ISO shell appeared"; exit 1 }
}
send -- "set -euo pipefail\r"
send -- "seed_device=\$(blkid -L LUNAOS_CI); test -n \"\$seed_device\"; mkdir -p /mnt/lunaos-ci; mount -o ro \"\$seed_device\" /mnt/lunaos-ci\r"
send -- "install -m 0600 /mnt/lunaos-ci/user_configuration.json /usr/share/lunaos/archinstall.json\r"
send -- "install -d /run/lunaos-archinstall-test-bin\r"
send -- "cat > /run/lunaos-archinstall-test-bin/archinstall <<'LUNAOS_WRAPPER'\r"
send -- "#!/bin/bash\r"
send -- "exec /usr/bin/archinstall --creds /mnt/lunaos-ci/user_credentials.json \"\$@\"\r"
send -- "LUNAOS_WRAPPER\r"
send -- "chmod 0755 /run/lunaos-archinstall-test-bin/archinstall\r"
send -- "export PATH=/run/lunaos-archinstall-test-bin:\$PATH\r"
send -- "nmcli networking on; network_device=\$(nmcli -t -f TYPE,DEVICE device | grep '^ethernet:' | cut -d: -f2 | head -n1); test -n \"\$network_device\"; nmcli --wait 45 device connect \"\$network_device\"; curl --fail --silent --show-error --connect-timeout 15 --max-time 30 https://geo.mirror.pkgbuild.com/core/os/x86_64/core.db -o /dev/null\r"
expect {
  -re {root@[^\r\n]*[#] ?} {}
  timeout { puts stderr "FAIL: live ISO could not establish network access to the official Arch mirror"; exit 1 }
  eof { puts stderr "FAIL: live ISO exited during network setup"; exit 1 }
}
send -- "lunaos-install\r"
expect {
  -re {type INSTALL LUNAOS exactly: $} { send -- "INSTALL LUNAOS\r" }
  -re {The guided installer requires an interactive terminal} { puts stderr "FAIL: production installer did not receive a tty"; exit 1 }
  timeout { puts stderr "FAIL: production installer confirmation prompt did not appear"; exit 1 }
  eof { puts stderr "FAIL: live ISO exited before installer confirmation"; exit 1 }
}
expect {
  -re {Failed to sync Arch Linux package database} {
    expect {
      -re {root@[^\r\n]*[#] ?} {}
      timeout { puts stderr "FAIL: archinstall package database sync failed and returned no live shell"; exit 1 }
      eof { puts stderr "FAIL: live ISO exited after archinstall package database sync failed"; exit 1 }
    }
    send -- "printf '\\nLUNAOS_INSTALL_SYNC_DIAGNOSTICS\\n'; cat /var/log/archinstall/install.log; printf '\\nLUNAOS_LIVE_MIRRORLIST\\n'; cat /etc/pacman.d/mirrorlist; printf '\\nLUNAOS_LIVE_NETWORK\\n'; ip route; nmcli device status\r"
    expect -re {root@[^\r\n]*[#] ?}
    send -- "systemctl poweroff\r"
    expect eof
    wait
    puts stderr "FAIL: archinstall could not sync the Arch package database; see captured mirror, network, and archinstall logs"
    exit 1
  }
  -re {root@[^\r\n]*[#] ?} {}
  timeout { puts stderr "FAIL: Archinstall did not return to the live shell after installation"; exit 1 }
  eof { puts stderr "FAIL: live ISO exited before the installed-target reboot"; exit 1 }
}
send -- "mkdir -p /run/lunaos-installed-target; if mount -o ro /dev/vda2 /run/lunaos-installed-target && test -x /run/lunaos-installed-target/usr/bin/luna-core && test -x /run/lunaos-installed-target/usr/bin/luna-policy-broker && test -f /run/lunaos-installed-target/usr/lib/systemd/system/luna-core.service && test -f /run/lunaos-installed-target/usr/lib/systemd/system/luna-policy-broker.service; then echo LUNAOS_TEST_INSTALL_TREE=PASS; umount /run/lunaos-installed-target; else echo LUNAOS_TEST_INSTALL_TREE=FAIL; umount /run/lunaos-installed-target 2>/dev/null || true; fi\r"
expect {
  -re {LUNAOS_TEST_INSTALL_TREE=PASS} {}
  -re {LUNAOS_TEST_INSTALL_TREE=FAIL} {
    send -- "systemctl poweroff\r"
    expect eof
    wait
    puts stderr "FAIL: archinstall returned without installing LunaOS binaries and systemd units to /dev/vda2"
    exit 1
  }
  timeout { puts stderr "FAIL: could not verify the installed LunaOS tree before reboot"; exit 1 }
  eof { puts stderr "FAIL: live ISO exited before installed-tree verification"; exit 1 }
}
send -- "systemctl reboot\r"
expect {
  -re {LUNAOS_INSTALL_SMOKE=PASS installed_boot=1 core=active broker=active goal=completed evidence=verified} {}
  -re {LUNAOS_INSTALL_SMOKE=FAIL} { puts stderr "FAIL: installed target acceptance service reported failure"; exit 1 }
  eof { puts stderr "FAIL: QEMU exited before the installed target acceptance marker"; exit 1 }
  timeout { puts stderr "FAIL: installed target did not complete the goal acceptance check within timeout"; exit 1 }
}
wait
exit 0
