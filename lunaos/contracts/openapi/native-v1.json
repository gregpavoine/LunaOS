{
  "openapi": "3.1.0",
  "info": {
    "title": "LunaOS Native Core API",
    "version": "0.1.0",
    "description": "Initial local Rust API. Goal operations require an owner bearer token. Capability states describe this build only and are not target-readiness evidence."
  },
  "servers": [{"url": "http://127.0.0.1:7766"}],
  "security": [{"OwnerBearer": []}],
  "paths": {
    "/v1/goals": {
      "post": {
        "operationId": "createGoal",
        "parameters": [{"name": "Idempotency-Key", "in": "header", "required": true, "schema": {"type": "string", "minLength": 1, "maxLength": 128}}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateGoal"}}}},
        "responses": {"200": {"description": "Created or idempotently returned goal", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/GoalView"}}}}, "400": {"description": "Invalid request or idempotency conflict"}, "401": {"description": "Owner authentication required"}, "403": {"description": "Policy denied"}}
      }
    },
    "/v1/goals/{id}": {
      "get": {
        "operationId": "getGoal",
        "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}],
        "responses": {"200": {"description": "Goal status", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/GoalView"}}}}, "401": {"description": "Owner authentication required"}, "404": {"description": "Goal not found"}}
      }
    },
    "/v1/scheduler/tick": {
      "post": {"operationId": "tickScheduler", "responses": {"200": {"description": "One authorized job completed or scheduler reported idle success", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TickResult"}}}}, "401": {"description": "Owner authentication required"}}}
    },
    "/v1/system/capabilities": {
      "get": {"operationId": "getCapabilities", "security": [], "responses": {"200": {"description": "Current capability state and explicit blockers"}}}
    }
  },
  "components": {
    "securitySchemes": {"OwnerBearer": {"type": "http", "scheme": "bearer", "bearerFormat": "opaque owner credential"}},
    "schemas": {
      "Metrics": {"type": "object", "additionalProperties": false, "properties": {"impact": {"type": "number", "minimum": 0, "maximum": 1}, "urgency": {"type": "number", "minimum": 0, "maximum": 1}, "user_value": {"type": "number", "minimum": 0, "maximum": 1}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "efficiency": {"type": "number", "minimum": 0, "maximum": 1}}},
      "ProvenanceInput": {"type": "object", "additionalProperties": false, "properties": {"source_id": {"type": ["string", "null"]}, "claim": {"type": ["string", "null"]}}, "description": "Input text is validated but never persisted in this initial slice. Clients cannot declare a source verified."},
      "CreateGoal": {"type": "object", "additionalProperties": false, "required": ["action"], "properties": {"action": {"type": "string", "pattern": "^[a-z][a-z0-9_.]{0,79}$"}, "metrics": {"$ref": "#/components/schemas/Metrics"}, "privacy_class": {"type": "string", "enum": ["general", "intimate", "biometric"]}, "expected_cost_minor": {"type": ["integer", "null"], "minimum": 0}, "provenance": {"$ref": "#/components/schemas/ProvenanceInput"}}},
      "GoalView": {"type": "object", "required": ["contract_version", "id", "action", "status", "score", "policy_code", "provenance_status", "queued"], "properties": {"contract_version": {"const": 1}, "id": {"type": "string", "format": "uuid"}, "action": {"type": "string"}, "status": {"type": "string"}, "score": {"type": ["number", "null"]}, "policy_code": {"type": "string"}, "provenance_status": {"type": "string", "enum": ["unknown", "verified", "disputed"]}, "queued": {"type": "boolean"}}},
      "TickResult": {"type": "object", "required": ["outcome", "goal_id", "reason"], "properties": {"outcome": {"type": "string", "enum": ["succeeded", "failed", "idle_success"]}, "goal_id": {"type": ["string", "null"]}, "reason": {"type": "string"}}}
    }
  }
}
