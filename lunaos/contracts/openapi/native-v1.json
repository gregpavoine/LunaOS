{
  "openapi": "3.1.0",
  "info": {
    "title": "LunaOS Native Core API",
    "version": "0.1.0",
    "description": "Initial local Rust API. Goal operations require an owner bearer token. Capability states describe this build only and are not target-readiness evidence."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:7766"
    }
  ],
  "security": [
    {
      "OwnerBearer": []
    }
  ],
  "paths": {
    "/v1/goals": {
      "get": {
        "operationId": "listGoals",
        "responses": {
          "200": {
            "description": "At most 100 owner goals ordered by score",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/GoalView"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Owner authentication required"
          }
        }
      },
      "post": {
        "operationId": "createGoal",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateGoal"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created or idempotently returned goal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GoalView"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or idempotency conflict"
          },
          "401": {
            "description": "Owner authentication required"
          },
          "403": {
            "description": "Policy denied"
          }
        }
      }
    },
    "/v1/goals/{id}": {
      "get": {
        "operationId": "getGoal",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Goal status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GoalView"
                }
              }
            }
          },
          "401": {
            "description": "Owner authentication required"
          },
          "404": {
            "description": "Goal not found"
          }
        }
      }
    },
    "/v1/goals/{id}/events": {
      "get": {
        "operationId": "listGoalEvents",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Most recent 100 privacy-safe append-only events in chronological order",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/GoalEventView"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Owner authentication required"
          },
          "404": {
            "description": "Goal not found"
          }
        }
      }
    },
    "/v1/goals/{id}/dependencies": {
      "post": {
        "operationId": "addGoalDependency",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddDependency"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Dependency added idempotently"
          },
          "400": {
            "description": "Dependency would create a cycle"
          },
          "401": {
            "description": "Owner authentication required"
          },
          "404": {
            "description": "Goal or prerequisite not found"
          }
        }
      }
    },
    "/v1/goals/{id}/pause": {
      "post": {
        "operationId": "pauseGoal",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Goal paused and active lease revoked",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GoalView"
                }
              }
            }
          },
          "400": {
            "description": "Invalid state transition"
          },
          "401": {
            "description": "Owner authentication required"
          },
          "404": {
            "description": "Goal not found"
          }
        }
      }
    },
    "/v1/goals/{id}/resume": {
      "post": {
        "operationId": "resumeGoal",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paused goal requeued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GoalView"
                }
              }
            }
          },
          "400": {
            "description": "Invalid state transition"
          },
          "401": {
            "description": "Owner authentication required"
          },
          "404": {
            "description": "Goal not found"
          }
        }
      }
    },
    "/v1/goals/{id}/cancel": {
      "post": {
        "operationId": "cancelGoal",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Goal cancelled and future execution prevented",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GoalView"
                }
              }
            }
          },
          "400": {
            "description": "Terminal goal cannot be changed"
          },
          "401": {
            "description": "Owner authentication required"
          },
          "404": {
            "description": "Goal not found"
          }
        }
      }
    },
    "/v1/scheduler/tick": {
      "post": {
        "operationId": "tickScheduler",
        "responses": {
          "200": {
            "description": "One authorized job completed, scheduler is waiting on dependencies or an active lease, or scheduler reported idle success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TickResult"
                }
              }
            }
          },
          "401": {
            "description": "Owner authentication required"
          }
        }
      }
    },
    "/v1/system/capabilities": {
      "get": {
        "operationId": "getCapabilities",
        "security": [],
        "responses": {
          "200": {
            "description": "Current capability state and explicit blockers"
          }
        }
      }
    },
    "/v1/goals/{id}/plan": {
      "get": {
        "operationId": "getGoalPlan",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Owner goal hierarchy and prerequisites",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GoalPlanView"
                }
              }
            }
          },
          "401": {
            "description": "Owner authentication required"
          },
          "404": {
            "description": "Goal not found"
          }
        }
      },
      "put": {
        "operationId": "replaceGoalPlan",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GoalPlan"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Atomically replaced plan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GoalPlanView"
                }
              }
            }
          },
          "400": {
            "description": "Cycle, oversized plan, unrunnable dependency, or goal state lock"
          },
          "401": {
            "description": "Owner authentication required"
          },
          "404": {
            "description": "Goal or prerequisite not found"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "OwnerBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque owner credential"
      }
    },
    "schemas": {
      "Metrics": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "impact": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "urgency": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "user_value": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "efficiency": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      },
      "ProvenanceInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "claim": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "description": "Input text is validated but never persisted in this initial slice. Clients cannot declare a source verified."
      },
      "AddDependency": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "depends_on_goal_id"
        ],
        "properties": {
          "depends_on_goal_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "CreateGoal": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.]{0,79}$"
          },
          "metrics": {
            "$ref": "#/components/schemas/Metrics"
          },
          "privacy_class": {
            "type": "string",
            "enum": [
              "general",
              "intimate",
              "biometric"
            ]
          },
          "expected_cost_minor": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "provenance": {
            "$ref": "#/components/schemas/ProvenanceInput"
          }
        }
      },
      "GoalView": {
        "type": "object",
        "required": [
          "contract_version",
          "id",
          "action",
          "status",
          "score",
          "policy_code",
          "provenance_status",
          "queued"
        ],
        "properties": {
          "contract_version": {
            "const": 1
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "action": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "idea",
              "planned",
              "approved",
              "active",
              "blocked",
              "paused",
              "completed",
              "cancelled",
              "failed"
            ]
          },
          "score": {
            "type": [
              "number",
              "null"
            ]
          },
          "policy_code": {
            "type": "string"
          },
          "provenance_status": {
            "type": "string",
            "enum": [
              "unknown",
              "verified",
              "disputed",
              "stale"
            ]
          },
          "queued": {
            "type": "boolean"
          }
        }
      },
      "GoalEventView": {
        "type": "object",
        "required": [
          "event_id",
          "goal_id",
          "kind",
          "decision_code",
          "created_at_utc"
        ],
        "properties": {
          "event_id": {
            "type": "integer"
          },
          "goal_id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string"
          },
          "decision_code": {
            "type": "string"
          },
          "created_at_utc": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TickResult": {
        "type": "object",
        "required": [
          "outcome",
          "goal_id",
          "reason"
        ],
        "properties": {
          "outcome": {
            "type": "string",
            "enum": [
              "succeeded",
              "failed",
              "blocked",
              "waiting_for_dependencies",
              "work_in_progress",
              "idle_success"
            ]
          },
          "goal_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "GoalPlan": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "parent_goal_id",
          "dependency_goal_ids"
        ],
        "properties": {
          "parent_goal_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "dependency_goal_ids": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "GoalPlanView": {
        "allOf": [
          {
            "$ref": "#/components/schemas/GoalPlan"
          },
          {
            "type": "object",
            "required": [
              "goal_id"
            ],
            "properties": {
              "goal_id": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        ]
      }
    }
  }
}
