{
  // LunaOS menu definition.
  // JSONC is used for Neovim-friendly highlighting, comments, and trailing commas.
  // IDs are object keys. Dotted IDs imply hierarchy: trigger.share.file belongs
  // under trigger.share.
  // Kind is inferred: action -> action, target -> link, otherwise submenu.
  // Dotted IDs define the tree. provider:"name" points a submenu at one of
  // the shell's providers (the providers map in shell/plugins/menu/Menu.qml);
  // new provider names cannot be declared here. See docs/menu.md.
  // Optional fields:
  //   aliases        alternate `lunaos menu summon <name>` routes; also searchable.
  //                  Reserved for established names users already type; new entries
  //                  should not normally add any.
  //   iconFont       font family used for the icon glyph, when it differs from the menu font
  //   title          header text shown when the submenu is open; defaults to label
  //   when           shell condition; hide row when it fails
  //   checked        shell condition; append ✓ when it succeeds
  //   disabled       shell condition; when it succeeds the row stays listed but
  //                  goes dim, takes a ✓ and can no longer be selected. Install
  //                  rows use it so software already on the machine reads as
  //                  installed instead of vanishing from the list.

  // Root Menu
  "apps": {"icon":"󰀻","label":"Apps","aliases":["app","applications"],"provider":"apps","action":"lunaos-shell lunaos.dock apps"},
  "learn": {"icon":"󰧑","label":"Learn"},
  "appearance": {"icon":"󰏘","label":"Appearance","aliases":["style"]},
  "trigger": {"icon":"󱓞","label":"Trigger"},
  "setup": {"icon":"","label":"Setup","aliases":["settings"]},
  "install": {"icon":"󰉉","label":"Install"},
  "remove": {"icon":"󰭌","label":"Remove","aliases":["uninstall"]},
  "update": {"icon":"","label":"Update","aliases":["restart","refresh"]},
  "about": {"icon":"","label":"About","action":"lunaos-launch-about"},
  "system": {"icon":"","label":"System","aliases":["power-menu"]},

  // System
  "system.screensaver": {"icon":"󱄄","label":"Screensaver","action":"lunaos-launch-screensaver force"},
  "system.lock": {"icon":"","label":"Lock","action":"lunaos-system-lock"},
  "system.suspend": {"icon":"󰒲","label":"Suspend","when":"! lunaos-toggle-enabled suspend-off && ! lunaos-sleep-disabled","action":"systemctl suspend"},
  "system.hibernate": {"icon":"󰤁","label":"Hibernate","when":"lunaos-hibernation-available && ! lunaos-sleep-disabled","action":"systemctl hibernate"},
  "system.logout": {"icon":"󰍃","label":"Logout","action":"lunaos-system logout"},
  "system.reboot": {"icon":"󰜉","label":"Reboot","action":"lunaos-system reboot"},
  "system.shutdown": {"icon":"󰐥","label":"Shutdown","action":"lunaos-system shutdown"},

  // Learn
  "learn.keybindings": {"icon":"","label":"Keybindings","action":"lunaos-menu-keybindings"},
  "learn.lunaos": {"icon":"","label":"LunaOS","action":"lunaos-launch-webapp 'https://omarchy.org/manual/'"},
  "learn.hyprland": {"icon":"","label":"Hyprland","action":"lunaos-launch-webapp 'https://wiki.hypr.land/'"},
  "learn.arch": {"icon":"󰣇","label":"Arch","action":"lunaos-launch-webapp 'https://wiki.archlinux.org/title/Main_page'"},
  "learn.neovim": {"icon":"","label":"Neovim","action":"lunaos-launch-webapp 'https://www.lazyvim.org/keymaps'"},
  "learn.bash": {"icon":"󱆃","label":"Bash","action":"lunaos-launch-webapp 'https://devhints.io/bash'"},
  "learn.tmux-keybindings": {"icon":"","label":"Tmux","action":"lunaos-menu-tmux-keybindings"},
  "learn.herdr-keybindings": {"icon":"","label":"Herdr","action":"lunaos-menu-herdr-keybindings"},
  "learn.community": {"icon":"󰙯","label":"Community","action":"lunaos-launch-discord-community"},

  // Appearance
  "appearance.theme": {"icon":"󰸌","label":"Theme","aliases":["theme","themes"],"action":"lunaos-shell shell summon lunaos.image-picker '{\"source\":\"themes\"}'"},
  "appearance.background": {"icon":"","label":"Background","aliases":["background","wallpaper"],"action":"background=$(lunaos-theme-bg-switcher); [[ -n $background ]] && lunaos-theme-bg-set \"$background\""},
  "appearance.font": {"icon":"","label":"Font","provider":"fonts"},
  "appearance.top-bar": {"icon":"󰍜","label":"Menu Bar"},
  "appearance.top-bar.hide": {"icon":"󰈉","label":"Hide Bar","when":"! lunaos-toggle-enabled bar-off","action":"lunaos-toggle-bar"},
  "appearance.top-bar.show": {"icon":"󰈈","label":"Show Bar","when":"lunaos-toggle-enabled bar-off","action":"lunaos-toggle-bar"},
  "appearance.top-bar.position": {"icon":"","label":"Position Bar"},
  "appearance.top-bar.background": {"icon":"󰂵","label":"Bar Background"},
  "appearance.top-bar.background.opaque": {"icon":"󰝤","label":"Opaque Bar","checked":"[[ $(lunaos-bar background) == \"opaque\" ]]","action":"lunaos-bar background opaque"},
  "appearance.top-bar.background.glassy": {"icon":"󰂵","label":"Glassy Bar","checked":"[[ $(lunaos-bar background) == \"glassy\" ]]","action":"lunaos-bar background glassy"},
  "appearance.top-bar.background.clear": {"icon":"󰝣","label":"Clear Bar","checked":"[[ $(lunaos-bar background) == \"none\" ]]","action":"lunaos-bar background none"},
  "appearance.top-bar.indicators": {"icon":"󰋽","label":"Bar Indicators"},
  "appearance.top-bar.indicators.battery-percentage-on": {"icon":"󰁹","label":"Show Battery %","when":"lunaos-hw-laptop && [[ $(lunaos-bar get lunaos.power showPercentage) != true ]]","action":"lunaos-shell lunaos.power togglePercentage"},
  "appearance.top-bar.indicators.battery-percentage-off": {"icon":"󰁹","label":"Hide Battery %","when":"lunaos-hw-laptop && [[ $(lunaos-bar get lunaos.power showPercentage) == true ]]","action":"lunaos-shell lunaos.power togglePercentage"},
  "appearance.top-bar.indicators.clock": {"icon":"󰥔","label":"Clock"},
  "appearance.top-bar.indicators.clock.sunday-24h": {"icon":"󰥔","label":"Sunday 14:30","when":"[[ $(lunaos-bar position) != \"left\" && $(lunaos-bar position) != \"right\" ]]","checked":"[[ $(lunaos-bar get lunaos.clock format) == \"dddd HH:mm\" ]]","action":"lunaos-bar set lunaos.clock format \"dddd HH:mm\""},
  "appearance.top-bar.indicators.clock.sunday-12h": {"icon":"󰥔","label":"Sunday 2:30 PM","when":"[[ $(lunaos-bar position) != \"left\" && $(lunaos-bar position) != \"right\" ]]","checked":"[[ $(lunaos-bar get lunaos.clock format) == \"dddd h:mm AP\" ]]","action":"lunaos-bar set lunaos.clock format \"dddd h:mm AP\""},
  "appearance.top-bar.indicators.clock.sunday-seconds-24h": {"icon":"󰥔","label":"Sunday 14:30:05","when":"[[ $(lunaos-bar position) != \"left\" && $(lunaos-bar position) != \"right\" ]]","checked":"[[ $(lunaos-bar get lunaos.clock format) == \"dddd HH:mm:ss\" ]]","action":"lunaos-bar set lunaos.clock format \"dddd HH:mm:ss\""},
  "appearance.top-bar.indicators.clock.sunday-seconds-12h": {"icon":"󰥔","label":"Sunday 2:30:05 PM","when":"[[ $(lunaos-bar position) != \"left\" && $(lunaos-bar position) != \"right\" ]]","checked":"[[ $(lunaos-bar get lunaos.clock format) == \"dddd h:mm:ss AP\" ]]","action":"lunaos-bar set lunaos.clock format \"dddd h:mm:ss AP\""},
  "appearance.top-bar.indicators.clock.time-24h": {"icon":"󰥔","label":"14:30","when":"[[ $(lunaos-bar position) != \"left\" && $(lunaos-bar position) != \"right\" ]]","checked":"[[ $(lunaos-bar get lunaos.clock format) == \"HH:mm\" ]]","action":"lunaos-bar set lunaos.clock format \"HH:mm\""},
  "appearance.top-bar.indicators.clock.time-12h": {"icon":"󰥔","label":"2:30 PM","when":"[[ $(lunaos-bar position) != \"left\" && $(lunaos-bar position) != \"right\" ]]","checked":"[[ $(lunaos-bar get lunaos.clock format) == \"h:mm AP\" ]]","action":"lunaos-bar set lunaos.clock format \"h:mm AP\""},
  "appearance.top-bar.indicators.clock.date-24h": {"icon":"󰥔","label":"Sun 3 May 14:30","when":"[[ $(lunaos-bar position) != \"left\" && $(lunaos-bar position) != \"right\" ]]","checked":"[[ $(lunaos-bar get lunaos.clock format) == \"ddd d MMM HH:mm\" ]]","action":"lunaos-bar set lunaos.clock format \"ddd d MMM HH:mm\""},
  "appearance.top-bar.indicators.clock.date-12h": {"icon":"󰥔","label":"Sun 3 May 2:30 PM","when":"[[ $(lunaos-bar position) != \"left\" && $(lunaos-bar position) != \"right\" ]]","checked":"[[ $(lunaos-bar get lunaos.clock format) == \"ddd d MMM h:mm AP\" ]]","action":"lunaos-bar set lunaos.clock format \"ddd d MMM h:mm AP\""},
  "appearance.top-bar.indicators.clock.week": {"icon":"󰥔","label":"3 May W18 2026","when":"[[ $(lunaos-bar position) != \"left\" && $(lunaos-bar position) != \"right\" ]]","checked":"[[ $(lunaos-bar get lunaos.clock format) == \"d MMMM 'W'ww yyyy\" ]]","action":"lunaos-bar set lunaos.clock format \"d MMMM 'W'ww yyyy\""},
  "appearance.top-bar.indicators.clock.iso": {"icon":"󰥔","label":"2026-05-03 14:30","when":"[[ $(lunaos-bar position) != \"left\" && $(lunaos-bar position) != \"right\" ]]","checked":"[[ $(lunaos-bar get lunaos.clock format) == \"yyyy-MM-dd HH:mm\" ]]","action":"lunaos-bar set lunaos.clock format \"yyyy-MM-dd HH:mm\""},
  "appearance.top-bar.indicators.clock.stacked-24h": {"icon":"󰥔","label":"14 — 30","when":"[[ $(lunaos-bar position) == \"left\" || $(lunaos-bar position) == \"right\" ]]","checked":"[[ $(lunaos-bar get lunaos.clock verticalFormat) == $'HH\\n—\\nmm' ]]","action":"lunaos-bar set lunaos.clock verticalFormat $'HH\\n—\\nmm'"},
  "appearance.top-bar.indicators.clock.stacked-12h": {"icon":"󰥔","label":"2 — 30 PM","when":"[[ $(lunaos-bar position) == \"left\" || $(lunaos-bar position) == \"right\" ]]","checked":"[[ $(lunaos-bar get lunaos.clock verticalFormat) == $'h\\n—\\nmm\\nAP' ]]","action":"lunaos-bar set lunaos.clock verticalFormat $'h\\n—\\nmm\\nAP'"},
  "appearance.top-bar.indicators.clock.stacked-date": {"icon":"󰥔","label":"03 May W18 '26","when":"[[ $(lunaos-bar position) == \"left\" || $(lunaos-bar position) == \"right\" ]]","checked":"[[ $(lunaos-bar get lunaos.clock verticalFormat) == $'dd\\nMMM\\n\\'W\\'ww\\n\\'\\'yy' ]]","action":"lunaos-bar set lunaos.clock verticalFormat $'dd\\nMMM\\n\\'W\\'ww\\n\\'\\'yy'"},
  "appearance.top-bar.indicators.clock.stacked-time": {"icon":"󰥔","label":"14 30","when":"[[ $(lunaos-bar position) == \"left\" || $(lunaos-bar position) == \"right\" ]]","checked":"[[ $(lunaos-bar get lunaos.clock verticalFormat) == $'HH\\nmm' ]]","action":"lunaos-bar set lunaos.clock verticalFormat $'HH\\nmm'"},
  "appearance.top-bar.position.top": {"icon":"󰁝","label":"Top Bar","action":"lunaos-bar position top"},
  "appearance.top-bar.position.bottom": {"icon":"󰁅","label":"Bottom Bar","action":"lunaos-bar position bottom"},
  "appearance.top-bar.position.left": {"icon":"󰁍","label":"Left Bar","action":"lunaos-bar position left"},
  "appearance.top-bar.position.right": {"icon":"󰁔","label":"Right Bar","action":"lunaos-bar position right"},
  "appearance.windows": {"icon":"󰖲","label":"Windows"},
  "appearance.windows.gaps-on": {"icon":"","label":"Window Gaps On","when":"lunaos-hyprland-toggle-enabled window-no-gaps","action":"lunaos-hyprland-window-gaps-toggle"},
  "appearance.windows.gaps-off": {"icon":"","label":"Window Gaps Off","when":"! lunaos-hyprland-toggle-enabled window-no-gaps","action":"lunaos-hyprland-window-gaps-toggle"},
  "appearance.windows.corners": {"icon":"󰘇","label":"Window Corners"},
  "appearance.windows.corners.theme": {"icon":"󰏘","label":"Theme Corners","checked":"[[ $(lunaos-hyprland-corners) == \"theme\" ]]","action":"lunaos-hyprland-corners theme"},
  "appearance.windows.corners.sharp": {"icon":"󰝣","label":"Sharp Corners","checked":"[[ $(lunaos-hyprland-corners) == \"sharp\" ]]","action":"lunaos-hyprland-corners sharp"},
  "appearance.windows.corners.rounded": {"icon":"󰘇","label":"Rounded Corners","checked":"[[ $(lunaos-hyprland-corners) == \"rounded\" ]]","action":"lunaos-hyprland-corners rounded"},
  "appearance.windows.transparency": {"icon":"󰂵","label":"Window Opacity"},
  "appearance.windows.transparency.opaque": {"icon":"󰝤","label":"Opaque Windows","checked":"[[ $(lunaos-hyprland-window-transparency) == \"opaque\" ]]","action":"lunaos-hyprland-window-transparency opaque"},
  "appearance.windows.transparency.transparent": {"icon":"󰝣","label":"Transparent Windows","checked":"[[ $(lunaos-hyprland-window-transparency) == \"transparent\" ]]","action":"lunaos-hyprland-window-transparency transparent"},
  "appearance.windows.transparency.glassy": {"icon":"󰂵","label":"Glassy Windows","checked":"[[ $(lunaos-hyprland-window-transparency) == \"glassy\" ]]","action":"lunaos-hyprland-window-transparency glassy"},
  "appearance.windows.one-window-ratio-on": {"icon":"","label":"1-Window Ratio On","when":"! lunaos-hyprland-toggle-enabled single-window-aspect-ratio","action":"lunaos-hyprland-window-single-square-aspect-toggle"},
  "appearance.windows.one-window-ratio-off": {"icon":"","label":"1-Window Ratio Off","when":"lunaos-hyprland-toggle-enabled single-window-aspect-ratio","action":"lunaos-hyprland-window-single-square-aspect-toggle"},
  "appearance.branding": {"icon":"","iconFont":"omarchy","label":"Branding"},
  "appearance.branding.screensaver": {"icon":"󱄄","label":"Screensaver"},
  "appearance.branding.about": {"icon":"","label":"About"},
  "appearance.branding.about.text": {"icon":"","label":"Edit Text","action":"lunaos-branding-about text"},
  "appearance.branding.about.image": {"icon":"","label":"Set From Image","action":"lunaos-branding-about image"},
  "appearance.branding.about.default": {"icon":"","label":"Restore Default","action":"lunaos-branding-about reset"},
  "appearance.branding.screensaver.text": {"icon":"","label":"Edit Text","action":"lunaos-branding-screensaver text"},
  "appearance.branding.screensaver.image": {"icon":"","label":"Set From Image","action":"lunaos-branding-screensaver image"},
  "appearance.branding.screensaver.default": {"icon":"","label":"Restore Default","action":"lunaos-branding-screensaver reset"},
  "appearance.dock": {"icon":"󱂩","label":"Dock","when":"[[ $(lunaos-hyprland-workspace-layout-current) == \"floating\" ]]"},
  "appearance.dock.autohide": {"icon":"󰈉","label":"Auto-hide Dock","when":"[[ $(lunaos-dock autohide) == \"off\" ]]","action":"lunaos-dock autohide on"},
  "appearance.dock.always-on": {"icon":"󰈈","label":"Always-on Dock","when":"[[ $(lunaos-dock autohide) == \"on\" ]]","action":"lunaos-dock autohide off"},
  "appearance.dock.position": {"icon":"","label":"Dock Position"},
  "appearance.dock.position.top": {"icon":"󰁝","label":"Top Dock","checked":"[[ $(lunaos-dock position) == \"top\" ]]","action":"lunaos-dock position top"},
  "appearance.dock.position.bottom": {"icon":"󰁅","label":"Bottom Dock","checked":"[[ $(lunaos-dock position) == \"bottom\" ]]","action":"lunaos-dock position bottom"},
  "appearance.dock.position.left": {"icon":"󰁍","label":"Left Dock","checked":"[[ $(lunaos-dock position) == \"left\" ]]","action":"lunaos-dock position left"},
  "appearance.dock.position.right": {"icon":"󰁔","label":"Right Dock","checked":"[[ $(lunaos-dock position) == \"right\" ]]","action":"lunaos-dock position right"},
  "appearance.workspace-layout": {"icon":"󱂬","label":"Workspace Layout","title":"Default Workspace Layout"},
  "appearance.workspace-layout.dwindle": {"icon":"󱓻","label":"Tiling","checked":"[[ $(lunaos-hyprland-workspace-layout-default) == \"dwindle\" ]]","action":"lunaos-hyprland-workspace-layout-default dwindle"},
  "appearance.workspace-layout.scrolling": {"icon":"󰝥","label":"Scrolling","checked":"[[ $(lunaos-hyprland-workspace-layout-default) == \"scrolling\" ]]","action":"lunaos-hyprland-workspace-layout-default scrolling"},
  "appearance.workspace-layout.floating": {"icon":"󰔶","label":"Floating","checked":"[[ $(lunaos-hyprland-workspace-layout-default) == \"floating\" ]]","action":"lunaos-hyprland-workspace-layout-default floating"},
  "appearance.animations-on": {"icon":"󰗘","label":"Animations On","when":"lunaos-hyprland-toggle-enabled no-animations","action":"lunaos-toggle-animations"},
  "appearance.animations-off": {"icon":"󰗘","label":"Animations Off","when":"! lunaos-hyprland-toggle-enabled no-animations","action":"lunaos-toggle-animations"},
  "appearance.unlock": {"icon":"󰟵","label":"Unlock","aliases":["unlock"],"action":"unlock=$(lunaos-plymouth-switcher); if [[ $unlock == default ]]; then lunaos-launch-floating-terminal-with-presentation lunaos-plymouth-reset; elif [[ -n $unlock ]]; then lunaos-launch-floating-terminal-with-presentation \"lunaos-plymouth-set-by-theme $(printf %q \"$unlock\")\"; fi"},

  // Trigger
  "trigger.toggle": {"icon":"󰔎","label":"Toggle","aliases":["toggle","toggles"]},
  "trigger.toggle.idle-lock-on": {"icon":"","label":"Stay Awake","when":"[[ ! -f ~/.local/state/lunaos/indicators/stay-awake ]]","action":"lunaos-toggle-idle"},
  "trigger.toggle.idle-lock-off": {"icon":"","label":"Allow Sleep","when":"[[ -f ~/.local/state/lunaos/indicators/stay-awake ]]","action":"lunaos-toggle-idle"},
  "trigger.toggle.notifications-on": {"icon":"󰂛","label":"Notifications On","when":"[[ $(lunaos-shell notifications isDnd) == on ]]","action":"lunaos-toggle-notification-silencing"},
  "trigger.toggle.notifications-off": {"icon":"󰂛","label":"Silence Notifications","when":"[[ $(lunaos-shell notifications isDnd) != on ]]","action":"lunaos-toggle-notification-silencing"},
  "trigger.toggle.nightlight-on": {"icon":"󰔎","label":"Nightlight On","when":"[[ $(lunaos-toggle-nightlight --status) != *'\"enabled\":true'* ]]","action":"lunaos-toggle-nightlight"},
  "trigger.toggle.nightlight-off": {"icon":"󰔎","label":"Nightlight Off","when":"[[ $(lunaos-toggle-nightlight --status) == *'\"enabled\":true'* ]]","action":"lunaos-toggle-nightlight"},
  "trigger.toggle.screensaver-on": {"icon":"󱄄","label":"Screensaver On","when":"lunaos-toggle-enabled screensaver-off","action":"lunaos-toggle-screensaver"},
  "trigger.toggle.screensaver-off": {"icon":"󱄄","label":"Screensaver Off","when":"! lunaos-toggle-enabled screensaver-off","action":"lunaos-toggle-screensaver"},
  "trigger.toggle.crash-capture-on": {"icon":"󱚡","label":"Crash Capture On","when":"lunaos-toggle-enabled crash-capture-off","action":"lunaos-toggle-crash-capture"},
  "trigger.toggle.crash-capture-off": {"icon":"󱚡","label":"Crash Capture Off","when":"! lunaos-toggle-enabled crash-capture-off","action":"lunaos-toggle-crash-capture"},
  "trigger.emoji": {"icon":"","label":"Emoji","aliases":["emoji","emojis"],"action":"lunaos-menu-emoji"},
  "trigger.clipboard-history": {"icon":"󰅇","label":"Clipboard History","action":"lunaos-shell shell summon lunaos.clipboard"},
  "trigger.reminder": {"icon":"󰢌","label":"Reminder","aliases":["reminder"]},
  "trigger.capture": {"icon":"","label":"Capture","aliases":["capture","screenshot","screenrecord","screen-record","screenrecording"]},
  "trigger.capture.screenshot": {"icon":"","label":"Screenshot","action":"lunaos-capture-screenshot"},
  "trigger.capture.screenrecord.stop": {"icon":"","label":"Stop Screenrecording","when":"lunaos-capture-screenrecording --status","action":"lunaos-capture-screenrecording --stop-recording"},
  "trigger.capture.screenrecord": {"icon":"","label":"Screenrecord"},
  "trigger.capture.text": {"icon":"󰴑","label":"Text","action":"lunaos-capture-text"},
  "trigger.capture.qr": {"icon":"󰐲","label":"QR Code","action":"lunaos-capture-qr"},
  "trigger.capture.color": {"icon":"󰃉","label":"Color","action":"pkill hyprpicker || hyprpicker -a"},
  "trigger.capture.screenrecord.no-audio": {"icon":"","label":"With no audio","action":"lunaos-capture-screenrecording"},
  "trigger.capture.screenrecord.desktop-audio": {"icon":"","label":"With desktop audio","action":"lunaos-capture-screenrecording --with-desktop-audio"},
  "trigger.capture.screenrecord.microphone": {"icon":"","label":"With desktop + microphone audio","action":"lunaos-capture-screenrecording --with-desktop-audio --with-microphone-audio"},
  "trigger.capture.screenrecord.webcam": {"icon":"","label":"With desktop + microphone audio + webcam","when":"lunaos-hw-webcam","action":"lunaos-capture-screenrecording-with-webcam"},
  "trigger.transcode": {"icon":"󰧸","label":"Transcode","action":"lunaos-transcode"},
  "trigger.share": {"icon":"","label":"Share","aliases":["share"]},
  "trigger.hardware": {"icon":"","label":"Hardware","aliases":["hardware","hw"]},
  "trigger.tests": {"icon":"󰓅","label":"Speed Test"},
  "trigger.hardware.laptop-display-on": {"icon":"󰛧","label":"Laptop Display On","when":"lunaos-hw-laptop && lunaos-hyprland-toggle-enabled internal-monitor-disable","action":"lunaos-hyprland-monitor-internal toggle"},
  "trigger.hardware.laptop-display-off": {"icon":"󰛧","label":"Laptop Display Off","when":"lunaos-hw-laptop && ! lunaos-hyprland-toggle-enabled internal-monitor-disable","action":"lunaos-hyprland-monitor-internal toggle"},
  "trigger.hardware.mirror-display-on": {"icon":"󰍹","label":"Display Mirroring On","when":"lunaos-hw-laptop && ! lunaos-hyprland-toggle-enabled internal-monitor-mirror","action":"lunaos-hyprland-monitor-internal-mirror toggle"},
  "trigger.hardware.mirror-display-off": {"icon":"󰍹","label":"Display Mirroring Off","when":"lunaos-hw-laptop && lunaos-hyprland-toggle-enabled internal-monitor-mirror","action":"lunaos-hyprland-monitor-internal-mirror toggle"},
  "trigger.hardware.hybrid-gpu-on": {"icon":"","label":"Switch to Hybrid GPU","when":"lunaos-hw-hybrid-gpu && ! grep -q '\"mode\": \"Hybrid\"' /etc/supergfxd.conf","action":"lunaos-launch-floating-terminal-with-presentation lunaos-toggle-hybrid-gpu"},
  "trigger.hardware.hybrid-gpu-off": {"icon":"","label":"Switch to Integrated GPU","when":"lunaos-hw-hybrid-gpu && grep -q '\"mode\": \"Hybrid\"' /etc/supergfxd.conf","action":"lunaos-launch-floating-terminal-with-presentation lunaos-toggle-hybrid-gpu"},
  "trigger.hardware.touchpad-on": {"icon":"󰟸","label":"Enable Touchpad","when":"lunaos-hw-touchpad && [[ -f ~/.local/state/lunaos/toggles/hypr/touchpad-disabled-name ]]","action":"lunaos-toggle-touchpad"},
  "trigger.hardware.touchpad-off": {"icon":"󰟸","label":"Disable Touchpad","when":"lunaos-hw-touchpad && [[ ! -f ~/.local/state/lunaos/toggles/hypr/touchpad-disabled-name ]]","action":"lunaos-toggle-touchpad"},
  "trigger.hardware.touchpad-haptics": {"icon":"󰌌","label":"Touchpad Haptics"},
  "trigger.hardware.touchpad-haptics.low": {"icon":"󰌌","label":"low","when":"lunaos-hw-dell-xps-haptic-touchpad && lunaos-cmd-present dell-xps-touchpad-haptics","checked":"[[ \"$(dell-xps-touchpad-haptics get)\" == \"low\" ]]","action":"dell-xps-touchpad-haptics set low"},
  "trigger.hardware.touchpad-haptics.mid": {"icon":"󰌌","label":"mid","when":"lunaos-hw-dell-xps-haptic-touchpad && lunaos-cmd-present dell-xps-touchpad-haptics","checked":"[[ \"$(dell-xps-touchpad-haptics get)\" == \"mid\" ]]","action":"dell-xps-touchpad-haptics set mid"},
