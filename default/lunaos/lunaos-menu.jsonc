  // Update
  "update.lunaos": {"icon":"","iconFont":"omarchy","label":"LunaOS","action":"lunaos-launch-floating-terminal-with-presentation lunaos-update"},
  "update.channel": {"icon":"󰔫","label":"Channel"},
  "update.kernel": {"icon":"","label":"Kernel","when":"(( $(lunaos-kernel list | wc -l) > 1 ))","provider":"kernels"},
  "update.config": {"icon":"","label":"Config","title":"Reset to default"},
  "update.themes": {"icon":"󰸌","label":"Extra Themes","when":"lunaos-theme-extras","action":"lunaos-launch-floating-terminal-with-presentation lunaos-theme-update"},
  "update.process": {"icon":"","label":"Process","title":"Restart"},
  "update.hardware": {"icon":"󰇅","label":"Hardware","title":"Restart"},
  "update.firmware": {"icon":"","label":"Firmware","action":"lunaos-launch-floating-terminal-with-presentation lunaos-update-firmware"},
  "update.password": {"icon":"","label":"Password"},
  "update.timezone": {"icon":"","label":"Timezone","action":"lunaos-menu-timezone"},
  "update.time": {"icon":"","label":"Time","action":"lunaos-launch-floating-terminal-with-presentation lunaos-update-time"},
  "update.channel.stable": {"icon":"🟢","label":"Stable","checked":"[[ \"$(lunaos-channel-current)\" == \"stable\" ]]","action":"lunaos-launch-floating-terminal-with-presentation 'lunaos-channel-set stable'"},
  "update.channel.rc": {"icon":"🟡","label":"RC","checked":"[[ \"$(lunaos-channel-current)\" == \"rc\" ]]","action":"lunaos-launch-floating-terminal-with-presentation 'lunaos-channel-set rc'"},
  "update.channel.edge": {"icon":"🟠","label":"Edge","checked":"[[ \"$(lunaos-channel-current)\" == \"edge\" ]]","action":"lunaos-launch-floating-terminal-with-presentation 'lunaos-channel-set edge'"},
  "update.channel.dev": {"icon":"🔴","label":"Dev","checked":"[[ \"$(lunaos-channel-current)\" == \"dev\" ]]","action":"lunaos-launch-floating-terminal-with-presentation 'lunaos-channel-set dev'"},
  "update.process.hyprsunset": {"icon":"","label":"Hyprsunset","action":"lunaos-restart-hyprsunset"},
  "update.process.shell": {"icon":"󰍜","label":"Shell","action":"lunaos-restart-shell"},
