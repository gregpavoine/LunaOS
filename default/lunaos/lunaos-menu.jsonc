  // Remove
  "remove.package": {"icon":"󰣇","label":"Package","action":"xdg-terminal-exec --app-id=org.lunaos.terminal lunaos-pkg-remove"},
  "remove.ai": {"icon":"󱚤","label":"AI","title":"Remove"},
  "remove.dictation": {"icon":"","label":"Dictation","when":"lunaos-pkg-present voxtype-bin || lunaos-pkg-present superwhisper-bin"},
  "remove.service": {"icon":"","label":"Services","title":"Remove"},
  "remove.development": {"icon":"󰵮","label":"Development","title":"Remove"},
  "remove.theme": {"icon":"󰸌","label":"Theme","action":"lunaos-theme-remove"},
  "remove.gaming": {"icon":"","label":"Gaming","title":"Remove"},
  "remove.browser": {"icon":"","label":"Browser","title":"Remove"},
  "remove.webapp": {"icon":"","label":"Web App","when":"grep -qE '^Exec=.*(lunaos-launch-webapp|lunaos-webapp-handler)' $HOME/.local/share/applications/*.desktop","action":"lunaos-webapp-remove"},
  "remove.tui": {"icon":"","label":"TUI","when":"grep -qE '^Exec=.*(\\$TERMINAL|xdg-terminal-exec).*-e' $HOME/.local/share/applications/*.desktop","action":"lunaos-tui-remove"},
  "remove.windows": {"icon":"󰍲","label":"Windows","when":"[[ -f $HOME/.local/share/applications/windows-vm.desktop ]]","action":"lunaos-launch-floating-terminal-with-presentation 'lunaos-windows-vm remove'"},
  "remove.preinstalls": {"icon":"󰏓","label":"Preinstalls","when":"[[ ! -f $HOME/.local/state/lunaos/preinstalls-removed ]]","action":"lunaos-launch-floating-terminal-with-presentation lunaos-remove-preinstalls"},
  "remove.security": {"icon":"","label":"Security","title":"Remove"},
  "remove.security.fingerprint": {"icon":"󰈷","label":"Fingerprint","when":"lunaos-pkg-present fprintd","action":"lunaos-launch-floating-terminal-with-presentation lunaos-remove-security-fingerprint"},
