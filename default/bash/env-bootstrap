# Single source of truth for LUNAOS_PATH + PATH adjustments. Sourced by:
#   /etc/profile.d/lunaos.sh                 (system login shells)
#   /etc/skel/.bashrc                         (interactive shells)
#   /usr/share/uwsm/env.d/10-lunaos          (Hyprland session via uwsm)
#   /usr/share/lunaos/default/bash/envs      (bash rc chain; SSH/non-login)

# /etc/lunaos.conf is written by lunaos-dev-link and reset by
# lunaos-dev-unlink. When absent, force the packaged default instead of
# preserving a stale inherited value.
if [ -f /etc/lunaos.conf ]; then
  . /etc/lunaos.conf
  : "${LUNAOS_PATH:=/usr/share/lunaos}"
else
  LUNAOS_PATH=/usr/share/lunaos
fi
export LUNAOS_PATH

# Only prepend in dev-link mode. On a production install, the binaries are
# already on PATH as /usr/bin/lunaos-* via the lunaos package — prepending
# /usr/share/lunaos/bin would just be noise.
if [ "$LUNAOS_PATH" != /usr/share/lunaos ]; then
  case ":$PATH:" in
    *":${LUNAOS_PATH%/}/bin:"*) ;;
    *) PATH="${LUNAOS_PATH%/}/bin${PATH:+:$PATH}" ;;
  esac
fi

# mise's command wrappers must precede real tool directories inherited from a
# parent shell, so scripts follow account switches without Bash functions.
# mise activate also keeps this directory ahead of its managed tool binaries.
lunaos_wrapper_dir="${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}/command-wrappers/bin"
lunaos_wrapper_path=$lunaos_wrapper_dir
if [ -n "${PATH:-}" ]; then
  lunaos_remaining_path=$PATH
  while :; do
    lunaos_path_entry=${lunaos_remaining_path%%:*}
    if [ "$lunaos_path_entry" != "$lunaos_wrapper_dir" ]; then
      lunaos_wrapper_path="$lunaos_wrapper_path:$lunaos_path_entry"
    fi
    case "$lunaos_remaining_path" in
      *:*) lunaos_remaining_path=${lunaos_remaining_path#*:} ;;
      *) break ;;
    esac
  done
fi
PATH=$lunaos_wrapper_path
unset lunaos_wrapper_dir lunaos_wrapper_path lunaos_remaining_path lunaos_path_entry

# User-level tool paths, appended so system binaries keep precedence. This is
# what lets login shells (ssh, bash -lc) and the uwsm session find mise-managed
# tools without an interactive rc. Keep these directories in sync with the PAM
# PATH line from install/config/ssh-command-path.sh, which covers SSH commands
# that run no shell setup at all.
case ":$PATH:" in
  *":$HOME/.local/share/mise/shims:"*) ;;
  *) PATH="${PATH:+$PATH:}$HOME/.local/share/mise/shims" ;;
esac
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) PATH="${PATH:+$PATH:}$HOME/.local/bin" ;;
esac
export PATH
