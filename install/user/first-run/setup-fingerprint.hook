#!/bin/bash

set -e

# Only invite when there's a reader to use and it isn't set up yet (the lock
# PAM file is the last thing the setup writes on success).
if lunaos-hw-fingerprint && [[ ! -f /etc/pam.d/lunaos-lock-fingerprint ]] &&
  lunaos-done ensure fingerprint-setup-invitation; then
  lunaos-notification-send -u critical -g 󰈷 "Setup Fingerprint Reader" \
    "Enable sudo and unlocking with your fingerprint." \
    --exec lunaos-launch-floating-terminal-with-presentation lunaos-setup-security-fingerprint
fi
