#!/bin/bash

set -e

# LunaOS ships no default agent, so invite once rather than picking one. An
# agent already chosen means the invitation has nothing to offer.
if [[ -z $(lunaos-default-agent) ]] && lunaos-done ensure agent-setup-invitation; then
  lunaos-notification-send -u critical -g 󰚩 "Set your default agent" \
    "Let your favorite agent help with LunaOS." \
    --exec lunaos menu summon setup.default.agent
fi
