#!/bin/bash

# lunaos:summary=Remove a supported browser and clean up LunaOS browser defaults
# lunaos:args=<chrome|brave|brave-origin|edge|firefox|zen>
# lunaos:examples=lunaos remove browser firefox | lunaos remove browser brave
# lunaos:requires-sudo=true

set_fallback_default_browser() {
  local current_browser
  current_browser=$(lunaos-cmd-default-browser)

  if [[ $current_browser != $1 ]]; then
    return
  fi

  if lunaos-cmd-present chromium; then
    env -u BROWSER XDG_CURRENT_DESKTOP= xdg-settings set default-web-browser chromium.desktop || true
  fi
}

case $1 in
chrome)
  echo "Removing Chrome..."
  set_fallback_default_browser google-chrome.desktop
  lunaos-pkg-drop google-chrome
  rm -f ~/.config/chrome-flags.conf
  sudo rm -f /etc/opt/chrome/policies/managed/color.json /etc/opt/chrome/policies/managed/lunaos.json
  ;;
edge)
  echo "Removing Edge..."
  set_fallback_default_browser microsoft-edge.desktop
  lunaos-pkg-drop microsoft-edge-stable-bin
  rm -f ~/.config/microsoft-edge-stable-flags.conf
  sudo rm -f /etc/opt/edge/policies/managed/color.json /etc/opt/edge/policies/managed/lunaos.json
  ;;
brave)
  echo "Removing Brave..."
  set_fallback_default_browser brave-browser.desktop
  lunaos-pkg-drop brave-bin
  rm -f ~/.config/brave-flags.conf

  if lunaos-pkg-missing brave-origin-bin; then
    sudo rm -rf /etc/brave
  fi
  ;;
brave-origin)
  echo "Removing Brave Origin..."
  set_fallback_default_browser brave-origin.desktop
  lunaos-pkg-drop brave-origin-bin
  rm -f ~/.config/brave-origin-flags.conf

  if lunaos-pkg-missing brave-bin; then
    sudo rm -rf /etc/brave
  fi
  ;;
firefox)
  echo "Removing Firefox..."
  set_fallback_default_browser firefox.desktop
  lunaos-pkg-drop firefox
  ;;
zen)
  echo "Removing Zen..."
  set_fallback_default_browser zen.desktop
  lunaos-pkg-drop zen-browser-bin
  ;;
*)
  echo "Usage: lunaos-remove-browser <chrome|brave|brave-origin|edge|firefox|zen>"
  exit 1
  ;;
esac
