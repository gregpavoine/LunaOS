#!/bin/bash

# lunaos:summary=Record dictation with the configured backend
# lunaos:args=<start|stop|toggle>
# lunaos:examples=lunaos dictation start | lunaos dictation toggle

if (($# != 1)) || [[ $1 != "start" && $1 != "stop" && $1 != "toggle" ]]; then
  echo "Usage: lunaos dictation <start|stop|toggle>" >&2
  exit 1
fi

config="${XDG_CONFIG_HOME:-$HOME/.config}/lunaos/defaults/dictation"
mkdir -p "${config%/*}"
exec 9> "$config.lock"
if ! flock -w 5 9; then
  echo "Dictation is busy; try again." >&2
  exit 1
fi

backend=$(lunaos-default-dictation) || exit 1
adapter="lunaos-dictation-$backend"
if lunaos-cmd-missing "$adapter"; then
  echo "The selected dictation backend ($backend) is not installed." >&2
  exit 1
fi
"$adapter" "$1" 9>&-
