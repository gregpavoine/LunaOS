#!/bin/bash

# lunaos:summary=Disable a shell plugin
# lunaos:group=plugin
# lunaos:args=<id>

set -euo pipefail

fail() {
  echo "lunaos-plugin-disable: $*" >&2
  exit 1
}

if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then
  echo "Usage: lunaos plugin disable <id>"
  exit 0
fi

id="${1:-}"
[[ -n $id ]] || fail "plugin id is required"

result=$(lunaos-shell shell setPluginEnabled "$id" false)
[[ $result == "ok" ]] ||
  fail "plugin '$id' is not known; run: lunaos-shell shell rescanPlugins"

echo "Disabled $id"
