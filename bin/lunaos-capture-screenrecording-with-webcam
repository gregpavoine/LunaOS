#!/bin/bash

# lunaos:summary=Pick a webcam and start a screen recording with it
# lunaos:examples=lunaos capture screenrecording-with-webcam

mapfile -t devices < <(lunaos-capture-webcam-list)
if (( ${#devices[@]} == 0 )); then
  lunaos-notification-send "$(lunaos-i18n capture.noWebcam)" -u critical -t 3000
  exit 1
fi

if (( ${#devices[@]} == 1 )); then
  device="${devices[0]%%[[:space:]]*}"
else
  selection=$(lunaos-menu-select "$(lunaos-i18n capture.selectWebcam)" "${devices[@]}" -- --width 520 --maxheight 520) || exit 1
  device="${selection%%[[:space:]]*}"
fi

exec lunaos-capture-screenrecording \
  --with-desktop-audio --with-microphone-audio \
  --with-webcam --webcam-device="$device"
