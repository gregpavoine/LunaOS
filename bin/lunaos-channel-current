#!/bin/bash

# lunaos:summary=Print the active LunaOS package channel

set -euo pipefail

# Dev is a linked source checkout: LUNAOS_PATH points somewhere other than
# the package-backed install at /usr/share/lunaos. This takes precedence over
# the package channels, since the checkout overrides whatever is installed.
if [[ $LUNAOS_PATH != "/usr/share/lunaos" ]]; then
  echo dev
  exit 0
fi

# lunaos-dev / lunaos-settings-dev are only shipped from the edge package
# repo, so their presence alone means edge. lunaos / lunaos-settings come
# from either the stable or rc mirror, distinguished by lunaos-version-channel
# (which reports the mirror as its first token).
if pacman -Q lunaos-dev lunaos-settings-dev >/dev/null 2>&1; then
  echo edge
elif pacman -Q lunaos lunaos-settings >/dev/null 2>&1; then
  channel=$(lunaos-version-channel 2>/dev/null | awk '{ print $1 }')
  case "$channel" in
    stable) echo stable ;;
    rc) echo rc ;;
    *) echo unknown ;;
  esac
else
  echo unknown
fi
