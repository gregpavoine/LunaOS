#!/bin/bash

# lunaos:summary=Remove Steam and all of its game libraries, configs, and caches.
# lunaos:requires-sudo=true

set -e

lunaos-lifecycle-dispatch pre-remove steam
lunaos-pkg-drop steam

rm -rf \
  "$HOME/.steam" \
  "$HOME/.local/share/Steam" \
  "$HOME/.config/steam" \
  "$HOME/.cache/steam"

echo ""
echo "Steam and its data have been removed."
