#!/bin/bash

# lunaos:summary=Install and configure Superwhisper dictation
# lunaos:requires-sudo=true

set -e

lunaos-pkg-add superwhisper-bin
bash /usr/share/superwhisper/setup-user
# Existing profiles may still use Right Alt, which conflicts with LunaOS.
# Keep a recording shortcut active while moving away from that binding.
shortcuts=$(superwhisper shortcuts show)
if [[ $(jq -r '.shortcuts.hold' <<< "$shortcuts") == "RightAlt" ]]; then
  if [[ -z $(jq -r '.shortcuts.toggle' <<< "$shortcuts") ]]; then
    superwhisper shortcuts set hold "RightSuper" >/dev/null
  else
    superwhisper shortcuts set hold none >/dev/null
  fi
fi
# Superwhisper requires a native recording shortcut; keep it separate from
# LunaOS's push-to-talk keys.
superwhisper shortcuts set toggle "Alt+Space" >/dev/null
superwhisper shortcuts set hold none >/dev/null
lunaos-dictation-use superwhisper
hyprctl reload >/dev/null
lunaos-notification-send -g  "$(lunaos-i18n dictation.superwhisperReady)" "$(lunaos-i18n dictation.hint)" -t 10000
superwhisper settings
