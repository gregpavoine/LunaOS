#!/bin/bash

# lunaos:summary=Remove the ChatGPT desktop app along with its configuration and caches.
# lunaos:requires-sudo=true

set -e

lunaos-pkg-drop openai-codex-desktop

# Not ~/.cache/codex-runtimes: the Codex CLI resolves its own runtime under
# there, and it ships in a different package that survives this one.
rm -rf \
  "$HOME/.config/Codex" \
  "$HOME/.cache/Codex"

echo ""
echo "ChatGPT has been removed."
