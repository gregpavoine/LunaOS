#!/bin/bash

# lunaos:summary=Print the active LunaOS dev-link git branch
# lunaos:hidden=true

lunaos_path=${LUNAOS_PATH:-/usr/share/lunaos}
lunaos_path=${lunaos_path%/}

[[ $lunaos_path != "/usr/share/lunaos" ]] || exit 1

branch=$(git -C "$lunaos_path" branch --show-current 2>/dev/null || true)
if [[ -z $branch ]]; then
  hash=$(git -C "$lunaos_path" rev-parse --short HEAD 2>/dev/null || true)
  [[ -n $hash ]] || exit 1
  branch="detached@$hash"
fi

echo "$branch"
