#!/bin/bash

# lunaos:summary=Overwrite the user config for the Plymouth drive decryption and boot sequence with the LunaOS default and rebuild it.
# lunaos:requires-sudo=true

# Reuse the fixed-file publisher so root never resolves the source checkout or
# follows a destination symlink while restoring the packaged assets.
exec "$LUNAOS_PATH/bin/lunaos-plymouth-set" --refresh-default
