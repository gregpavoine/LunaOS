#!/bin/bash

# lunaos:summary=Launch a floating terminal with the LunaOS presentation wrapper
# lunaos:args=<command>

# Export the current theme's gum styling so gum widgets match the active theme
# even after a theme switch (the inherited environment is captured at login).
source lunaos-restart-gum

cmd="$*"
# 130 is the user bailing with Ctrl-C; anything else gets the Done/Failed prompt.
presentation_script="lunaos-show-logo; $cmd; code=\$?; if (( code != 130 )); then lunaos-show-done \$code; fi"

exec setsid uwsm-app -- xdg-terminal-exec --app-id=org.lunaos.terminal --title=LunaOS -e bash -c "$presentation_script"
