#!/bin/bash

# lunaos:summary=Restore the preinstalled LunaOS applications (web apps, TUIs, and selected packages).
# lunaos:requires-sudo=true

if gum confirm --affirmative "$(lunaos-i18n common.yes)" --negative "$(lunaos-i18n common.no)" "$(lunaos-i18n preinstalls.confirmRestore)"; then
  echo -e "Restoring preinstalled LunaOS applications...\n"

  # Recreates the shipped .desktop launchers (web apps and TUIs).
  lunaos-refresh-applications || exit 1

  # Re-enable LunaOS's default mise tools for this user and rebuild their shims.
  if ! lunaos-mise-default-tools enable; then
    echo -e "\nCould not restore mise tools. Preinstalls remain marked as removed."
    exit 1
  fi

  # Mirrors the list in lunaos-remove-preinstalls; both track lunaos-base.packages
  if ! lunaos-pkg-add \
    aether \
    cliamp \
    libreoffice-fresh \
    pinta \
    obsidian \
    moonlight-qt \
    omacut \
    monologue \
    omacalc \
    omawrite \
    hype \
    signed; then
    echo -e "\nPreinstalls are still marked as removed. Fix the errors above and try again."
    exit 1
  fi

  # Last, so a failure above leaves the opt-out intact rather than restoring
  # keybindings for apps that never came back
  rm -f ~/.local/state/lunaos/preinstalls-removed
  hyprctl reload
fi
