#!/bin/bash

# lunaos:summary=Create a desktop launcher for a RetroArch game
# lunaos:args=[core path-to-game]
# lunaos:examples=lunaos games retro install snes9x ~/Games/roms/snes/game.sfc | lunaos-games-retro-install /usr/lib/libretro/mgba_libretro.so ~/Games/roms/gba/game.gba

set -e

if (( $# == 0 )); then
  mapfile -t cores < <(lunaos-games-retro-cores)

  if (( ${#cores[@]} == 0 )); then
    lunaos-notification-send -g 󰯉 "$(lunaos-i18n games.noCores)" "/usr/lib/libretro"
    exit 1
  fi

  core=$(lunaos-menu-select "$(lunaos-i18n games.corePrompt)" "${cores[@]}") || exit 0
  [[ -n $core ]] || exit 0
  core="${core##*(}"
  core="${core%)}"

  game_path=$(lunaos-menu-file "$(lunaos-i18n games.pickGame)" "$HOME/Games/roms" "7z bin ccd chd cue dmg elf fds gb gba gbc iso lha m3u md n64 nds nes pbp sfc smc swc zip z64") || exit 0
  [[ -n $game_path ]] || exit 0
elif (( $# == 2 )); then
  core="$1"
  game_path="$2"
else
  echo "Usage: lunaos-games-retro-install [core path-to-game]"
  echo "Example: lunaos-games-retro-install snes9x ~/Games/roms/snes/game.sfc"
  exit 1
fi

if [[ ! -f $game_path ]]; then
  echo "Game not found: $game_path"
  exit 1
fi

if [[ $core == */* ]]; then
  core_path="$core"
else
  core_path="/usr/lib/libretro/${core}_libretro.so"
fi

if [[ ! -f $core_path ]]; then
  echo "Core not found: $core_path"
  exit 1
fi

game_name=$(printf '%s' "${game_path##*/}" | sed 's/\.[^.]*$//; s/[[:space:]]*([^)]*)//g; s/[[:space:]]\+/ /g; s/^ //; s/ $//' | perl -Mopen=locale -pe 's/(^|[[:space:]])([^[:space:]])/$1\U$2/g')
desktop_name="$game_name"
desktop_id=$(printf '%s' "$desktop_name" | tr '[:upper:]' '[:lower:]' | tr -cs '[:alnum:]' '-' | sed 's/^-//; s/-$//')
desktop_dir="$HOME/.local/share/applications"
desktop_file="$desktop_dir/$desktop_id.desktop"
mkdir -p "$desktop_dir"

cat >"$desktop_file" <<EOF
[Desktop Entry]
Version=1.0
Name=$desktop_name
Comment=Play $game_name with RetroArch
Exec=retroarch -L "$core_path" "$game_path"
Terminal=false
Type=Application
Icon=retro-gaming
StartupNotify=true
Categories=Game;Emulator;
EOF

chmod +x "$desktop_file"
update-desktop-database "$desktop_dir" &>/dev/null || true

lunaos-notification-send -g 󰯉 "$(lunaos-i18n games.installed "$game_name")" "$(lunaos-i18n games.startHint)"
