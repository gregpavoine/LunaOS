#!/bin/bash -p

# lunaos:summary=Overwrite the package configuration for /etc/pacman with the LunaOS default of using its dedicated mirrors and repositories, then update all packages.
# lunaos:requires-sudo=true

if [[ $- != *p* ]]; then
  echo "Refusing an unsafe Bash startup." >&2
  exit 126
fi

security_entrypoint=$(/usr/bin/readlink -e -- "${BASH_SOURCE[0]}") || exit 126
source "${security_entrypoint%/*}/lunaos-security-functions" || exit 126
lunaos_security_require_privileged_bash_startup || exit 126
set -e
lunaos_security_sanitize_bash_environment "$0" "$@"
lunaos_security_require_source_root "$0"
# Channel switching calls this behind its own sanitized PATH and hands the
# caller's original path over the same way the updater receives it.
user_path=${LUNAOS_UPDATE_USER_PATH:-$PATH}
unset LUNAOS_UPDATE_USER_PATH
# Traps first, so a signal or failure during the entry revocation still
# exits through the cleanup path.
lunaos_security_install_sudo_cleanup_traps
lunaos_security_revoke_sudo_timestamp || exit 1
lunaos_security_enable_no_update_sudo

channel="${1:-}"
if [[ -n $channel && $channel != "stable" && $channel != "rc" && $channel != "edge" ]]; then
  echo "Invalid channel: $channel" >&2
  exit 2
fi

source "$LUNAOS_PATH/install/helpers/pacman.sh"
if ! platform=$(lunaos-hw-platform); then
  echo "Cannot tell this machine's platform. No repository configuration changed." >&2
  exit 1
fi
templates=$(lunaos_pacman_templates "$platform") || exit 1
if [[ -z $channel ]]; then
  channel=$(lunaos-channel-current) || exit 1
  case "$channel" in
    stable | rc | edge) ;;
    # A linked checkout uses the edge packages, just like channel-set dev.
    dev) channel=edge ;;
    unknown) channel=$(lunaos_pacman_default_channel "$platform") || exit 1 ;;
    *)
      echo "Cannot tell this machine's channel. No repository configuration changed." >&2
      exit 1
      ;;
  esac
fi
if [[ ! -f $templates/pacman-$channel.conf || ! -f $templates/mirrorlist-$channel ]]; then
  echo "LunaOS has no $channel channel for $platform. No repository configuration changed." >&2
  exit 1
fi

# Render the channel templates plus this machine's regional additions as the
# caller, so root only copies finished files. The scratch directory goes on
# every exit, including a failed render, a refused sudo prompt, or a signal;
# revoking the sudo timestamp stays the last thing the exit path does.
rendered=$(mktemp -d)
cleanup_refresh() {
  local status=$?
  rm -rf "$rendered"
  lunaos_security_exit_with_revoked_sudo "$status"
}
trap cleanup_refresh EXIT
"$LUNAOS_PATH/bin/lunaos-apply-pacman" --render "$channel" "$rendered"

sudo cp -f /etc/pacman.conf /etc/pacman.conf.bak
sudo cp -f /etc/pacman.d/mirrorlist /etc/pacman.d/mirrorlist.bak
echo "Setting channel to $channel"
sudo cp -f "$rendered/pacman.conf" /etc/pacman.conf
sudo cp -f "$rendered/mirrorlist" /etc/pacman.d/mirrorlist
rm -rf "$rendered"

# Allow user customization of /etc/pacman.conf before the upgrade runs, so
# custom repositories and IgnorePkg entries shape the downgrade-capable
# transaction below. The hook is user code: it runs cold behind the no-update
# wrapper, and the timestamp is revoked again afterwards so any authorization
# the hook obtained for itself cannot carry into the transaction.
lunaos_security_revoke_sudo_timestamp
PATH="$LUNAOS_PATH/default/lunaos/sudo-no-update:$user_path" \
  "$LUNAOS_PATH/bin/lunaos-hook" pre-refresh-pacman
lunaos_security_revoke_sudo_timestamp

# Stable and rc publish lunaos and lunaos-settings; the -dev pair is edge's.
# A stable or rc repository can still list an old -dev build (stable's listed
# 4.0.0.r1832 from August to October 2026), and -uu would move an edge machine
# onto it here, before lunaos-channel-set swaps the pair. That build predates
# command-scoped sudo, so the switch would stop short of its swap and leave the
# machine there. The -dev pair is left to the swap.
ignore=()
if [[ $channel == "stable" || $channel == "rc" ]]; then
  ignore=(--ignore lunaos-dev,lunaos-settings-dev)
fi

# Reset all package DBs and then update
lunaos-update-pacman -Syyuu --noconfirm "${ignore[@]}"
