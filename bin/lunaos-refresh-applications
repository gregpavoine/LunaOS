#!/bin/bash

# lunaos:summary=Ensure default application launchers are installed.

# Copy .desktop declarations
mkdir -p ~/.local/share/applications
cp "$LUNAOS_PATH"/applications/*.desktop ~/.local/share/applications/

if lunaos-cmd-present alacritty; then
  cp "$LUNAOS_PATH/default/alacritty/Alacritty.desktop" ~/.local/share/applications/
fi

update-desktop-database ~/.local/share/applications
