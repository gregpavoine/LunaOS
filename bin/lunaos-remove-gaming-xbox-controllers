#!/bin/bash

# lunaos:summary=Remove the xpadneo Xbox controller driver and undo its module/blacklist config.
# lunaos:group=remove
# lunaos:name=gaming xbox-controllers
# lunaos:requires-sudo=true

set -e

lunaos-pkg-drop xpadneo-dkms

sudo rm -f /etc/modprobe.d/blacklist-xpad.conf /etc/modules-load.d/xpadneo.conf

echo ""
echo "Xbox controller support removed. Reboot to fully unload xpadneo and restore xpad."
