#!/bin/bash

# lunaos:summary=Print the directory holding a theme, preferring a user-installed copy
# lunaos:args=<theme-name>
# lunaos:examples=lunaos theme dir tokyo-night

theme="${1:-}"

if [[ -z $theme ]]; then
  echo "Usage: lunaos-theme-dir <theme-name>" >&2
  exit 1
fi

if [[ -d $HOME/.config/lunaos/themes/$theme ]]; then
  echo "$HOME/.config/lunaos/themes/$theme"
else
  echo "$LUNAOS_PATH/themes/$theme"
fi
