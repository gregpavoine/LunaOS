#!/bin/bash

# lunaos:summary=Record dictation using Superwhisper
# lunaos:args=<start|stop|toggle>

case "${1:-}" in
  start) superwhisper start ;;
  stop)
    if lunaos-cmd-missing superwhisper || ! systemctl --user is-active --quiet superwhisper.service; then
      exit 0
    else
      superwhisper stop
    fi
    ;;
  toggle) superwhisper record ;;
  *) echo "Usage: lunaos dictation superwhisper <start|stop|toggle>" >&2; exit 1 ;;
esac
