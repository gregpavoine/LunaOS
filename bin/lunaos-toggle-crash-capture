#!/bin/bash

# lunaos:summary=Toggle crash capture notifications

# nf-md-robot_dead, escaped so this file reads without a Nerd Font.
readonly CRASH_GLYPH=$'\U000f16a1'

lunaos-toggle crash-capture-off

# The unit checks the same flag with ConditionPathExists, so stopping and
# starting only settles this session; the next login reads the flag itself.
if lunaos-toggle-enabled crash-capture-off; then
  systemctl --user stop lunaos-crash-watch.service
  lunaos-notification-send -g "$CRASH_GLYPH" "$(lunaos-i18n crash.captureDisabled)"
else
  systemctl --user start lunaos-crash-watch.service
  lunaos-notification-send -g "$CRASH_GLYPH" "$(lunaos-i18n crash.captureEnabled)"
fi
