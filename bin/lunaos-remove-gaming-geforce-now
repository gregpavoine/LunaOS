#!/bin/bash

# lunaos:summary=Remove the GeForce NOW Flatpak app and its data.
# lunaos:group=remove
# lunaos:name=gaming geforce-now

set -e

if lunaos-cmd-present flatpak && flatpak info com.nvidia.geforcenow &>/dev/null; then
  flatpak uninstall -y --delete-data com.nvidia.geforcenow
fi

echo ""
echo "GeForce NOW removed."
