#!/bin/bash

# lunaos:summary=Refresh the current theme from its templates.

THEME_NAME_PATH="$HOME/.local/state/lunaos/current/theme.name"

# Installers and migrations refresh the theme and then read the app configs it
# writes, so this waits for every retint rather than leaving some running.
if [[ -f $THEME_NAME_PATH ]]; then
  LUNAOS_THEME_WAIT=1 LUNAOS_THEME_SKIP_BACKGROUND=1 lunaos-theme-set "$(cat $THEME_NAME_PATH)"
fi
