#!/bin/bash

# lunaos:summary=Take a screenshot
# lunaos:group=capture
# lunaos:args=[smart|region|windows|fullscreen|scroll] [copy|save]
# lunaos:examples=lunaos screenshot | lunaos capture screenshot region
# lunaos:aliases=lunaos screenshot

if [[ -n ${LUNAOS_SCREENSHOT_DIR:-} && -z ${OMASNAP_SCREENSHOT_DIR:-} ]]; then
  export OMASNAP_SCREENSHOT_DIR="$LUNAOS_SCREENSHOT_DIR"
fi

omasnap_args=()
for arg in "$@"; do
  case "$arg" in
    copy) omasnap_args+=(--copy) ;;
    save) omasnap_args+=(--save) ;;
    slurp) ;;
    *) omasnap_args+=("$arg") ;;
  esac
done

exec omasnap "${omasnap_args[@]}"
