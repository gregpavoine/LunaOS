#!/bin/bash

# lunaos:summary=Reinstall all default LunaOS packages from the stable channel, or on Apple Silicon the edge channel
# lunaos:requires-sudo=true

set -e

# Reinstall all default LunaOS packages from the platform's default channel
# (stable, or edge on Apple Silicon) and downgrade any packages that are too new.

# Set the package repository to the platform's default channel
source "$LUNAOS_PATH/install/helpers/pacman.sh"
platform=$(lunaos-hw-platform)
channel=$(lunaos_pacman_default_channel "$platform")
lunaos-refresh-pacman "$channel"

# Downgrade any packages to that channel's setup
lunaos-update-pacman -Suu --noconfirm

# Ensure this platform's default packages are installed
default_packages=$(lunaos-pkg-defaults)
mapfile -t packages <<<"$default_packages"
lunaos-update-pacman -Syu --noconfirm --needed "${packages[@]}"
