#!/bin/bash

# lunaos:summary=Install Xbox Cloud Gaming as a web app and launch it.
# lunaos:group=install
# lunaos:name=gaming xbox-cloud

set -e

echo "Installing Xbox Cloud Gaming..."
lunaos-webapp-install "Xbox Cloud Gaming" "https://www.xbox.com/en-US/play" "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/xbox.png"

setsid lunaos-launch-webapp "https://www.xbox.com/en-US/play" >/dev/null 2>&1 &
