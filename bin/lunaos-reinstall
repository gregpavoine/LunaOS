#!/bin/bash

# lunaos:summary=Reinstall LunaOS packages and reset default configs
# lunaos:requires-sudo=true

set -e

echo -e "This will reinstall all default LunaOS packages and reset default configs.\nWarning: user config changes will be overwritten.\n"

if gum confirm "Are you sure you want to reinstall and lose config changes?"; then
  lunaos-reinstall-pkgs
  lunaos-reinstall-configs

  gum confirm "System has been reinstalled. Reboot?" && lunaos-system reboot
fi
