#!/bin/bash

# lunaos:summary=Launch a TUI or focus an existing terminal window for it
# lunaos:args=[--app-id=<app-id>] <command> [args...]

if [[ ${1:-} == --app-id=* ]]; then
  APP_ID="${1#--app-id=}"
else
  APP_ID="org.lunaos.$(basename "$1")"
fi

LAUNCH_COMMAND="lunaos-launch-tui $@"

exec lunaos-launch-or-focus "$APP_ID" "$LAUNCH_COMMAND"
