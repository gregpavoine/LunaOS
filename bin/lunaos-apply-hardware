#!/bin/bash

# lunaos:summary=Apply LunaOS hardware-specific packages and system configuration
# lunaos:group=apply
# lunaos:requires-sudo=true
# lunaos:examples=lunaos apply hardware --install-user dhh
# lunaos:hidden=true

set -euo pipefail

usage() {
  cat <<USAGE
Usage: lunaos apply hardware --install-user USER
       lunaos apply hardware --defer-provisioning

Runs idempotent hardware detection/setup for the installed machine. This is
called by lunaos-apply-system during ISO finalization and can be rerun later
for diagnostics or after hardware/package updates.

--defer-provisioning runs without an install user (deferred-provisioning installs create the user at
first boot); group grants are recorded in /var/lib/lunaos/provisioning/groups.

In an image build (/var/lib/lunaos/image/target exists) nothing runs here: every step is queued
for lunaos-provision-hardware on the machine's first boot.
USAGE
}

install_user="${LUNAOS_INSTALL_USER:-}"
defer_provisioning=0
while (($#)); do
  case "$1" in
    --install-user)
      install_user="${2:-}"
      shift 2
      ;;
    --defer-provisioning)
      defer_provisioning=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if (( EUID != 0 )); then
  echo "Error: lunaos-apply-hardware must run as root" >&2
  exit 1
fi

if (( defer_provisioning )); then
  install_user=""
else
  if [[ -z $install_user || $install_user == "root" ]]; then
    echo "Error: --install-user must name the target non-root user" >&2
    exit 1
  fi

  if ! getent passwd "$install_user" >/dev/null; then
    echo "Error: user '$install_user' does not exist" >&2
    exit 1
  fi
fi

export LUNAOS_INSTALL_USER="$install_user"
# Only lunaos-provision-hardware runs steps as an image's first boot.
unset LUNAOS_IMAGE_DEFERRED_HARDWARE
export LUNAOS_PATH="${LUNAOS_PATH:-/usr/share/lunaos}"
export LUNAOS_INSTALL="${LUNAOS_INSTALL:-$LUNAOS_PATH/install}"
export LUNAOS_INSTALL_LOG_FILE="${LUNAOS_INSTALL_LOG_FILE:-/var/log/lunaos-install.log}"
export PATH="$LUNAOS_PATH/bin:$PATH"

source "$LUNAOS_INSTALL/helpers/logging.sh"
source "$LUNAOS_INSTALL/helpers/image-target.sh"

lunaos_image_init
lunaos_image_lock
if lunaos_image_manifest_present; then
  lunaos_image_read_manifest
  lunaos_image_defer_hardware
else
  source "$LUNAOS_INSTALL/hardware/all.sh"
fi
