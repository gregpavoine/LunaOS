#!/bin/bash

# lunaos:summary=List themes that can style the Plymouth boot screen
# lunaos:examples=lunaos plymouth list

{
  find ~/.config/lunaos/themes/ -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -printf '%f\n' 2>/dev/null
  find "$LUNAOS_PATH/themes/" -mindepth 1 -maxdepth 1 -type d -printf '%f\n'
} | sort -u | while read -r name; do
  if [[ -f $(lunaos-theme-dir "$name")/preview-unlock.png ]]; then
    echo "$name"
  fi
done
