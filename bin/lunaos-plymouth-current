#!/bin/bash

# lunaos:summary=Show which theme is styling the Plymouth boot screen
# lunaos:examples=lunaos plymouth current

# lunaos-plymouth-set installs the theme's unlock.png as a byte-for-byte
# copy of logo.png, so matching it back identifies the current theme.
installed_logo=/usr/share/plymouth/themes/lunaos/logo.png

if cmp -s "$LUNAOS_PATH/default/plymouth/logo.png" "$installed_logo"; then
  echo default
  exit
fi

lunaos-plymouth-list | while read -r name; do
  if cmp -s "$(lunaos-theme-dir "$name")/unlock.png" "$installed_logo"; then
    echo "$name"
    exit
  fi
done
