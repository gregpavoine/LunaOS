#!/bin/bash

# lunaos:summary=Launch the default coding agent with a prompt
# lunaos:args=[--inline] <prompt...>
# lunaos:examples=lunaos agent prompt "Review this project"

# Prompts live here rather than on `lunaos agent`, where a bare prompt would
# shadow the subcommands under that group.

set -euo pipefail

inline=()
if [[ ${1:-} == "--inline" ]]; then
  inline=(--inline)
  shift
fi

if (($# == 0)); then
  echo "Usage: lunaos agent prompt [--inline] <prompt...>" >&2
  exit 1
fi

exec lunaos-agent "${inline[@]}" --prompt "$*"
