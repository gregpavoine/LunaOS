#!/bin/bash

# lunaos:summary=Launch or focus on a given web app identified by the window-pattern.
# lunaos:args=<window-pattern> <url-and-flags...>

if (($# == 0)); then
  echo "Usage: lunaos-launch-or-focus-webapp [window-pattern] [url-and-flags...]"
  exit 1
fi

WINDOW_PATTERN="$1"
shift
LAUNCH_COMMAND="lunaos-launch-webapp $@"

exec lunaos-launch-or-focus "$WINDOW_PATTERN" "$LAUNCH_COMMAND"
