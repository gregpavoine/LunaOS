#!/bin/bash

# lunaos:hidden=true
# lunaos:summary=Provide internal helpers for command-scoped sudo authentication

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  echo "lunaos-security-functions is an internal function library." >&2
  exit 64
fi

lunaos_security_require_privileged_bash_startup() {
  [[ $- == *p* ]] || return 1
  # The caller is this check's parent, under the number this /proc gives it.
  # arch-chroot runs the installer in a new PID namespace beneath the outer
  # /proc, where $$ names no process, or someone else's.
  /usr/bin/env -i /usr/bin/bash -p -c '
    stat=$(</proc/self/stat) || exit 1
    read -r _ caller _ <<<"${stat##*) }"
    mapfile -d "" -t argv <"/proc/$caller/cmdline" || exit 1
    executable=$(/usr/bin/readlink -e -- "/proc/$caller/exe") || exit 1
    [[ $executable == "/usr/bin/bash" &&
      ( ${argv[0]:-} == "/bin/bash" || ${argv[0]:-} == "/usr/bin/bash" ) &&
      ${argv[1]:-} == "-p" ]]
  ' lunaos-bash-startup
}

lunaos_security_sanitize_bash_environment() {
  local script=$1
  shift
  local entry name environment_fd environment_pid
  local -a unsets=()

  # Read the raw environment: privileged Bash ignores exported functions, but
  # leaves their records for ordinary child interpreters to import later.
  exec {environment_fd}< <(/usr/bin/env -0)
  environment_pid=$!
  while IFS= read -r -d '' entry <&"$environment_fd"; do
    name=${entry%%=*}
    case "$name" in
      BASH_ENV|ENV|SHELLOPTS|BASHOPTS|PS4|CDPATH|GLOBIGNORE|BASH_FUNC_*%%)
        unsets+=(-u "$name")
        ;;
    esac
  done
  exec {environment_fd}<&-
  wait "$environment_pid" || return 1
  if (( ${#unsets[@]} > 0 )); then
    exec /usr/bin/env "${unsets[@]}" /usr/bin/bash -p -- "$script" "$@"
  fi
}

lunaos_security_require_source_root() {
  local command_source command_name=${1##*/}
  command_source=$(/usr/bin/readlink -e -- "$1") || return 1

  # A runtime root selects the code used by this invocation. Accept the
  # canonical checkout containing the entrypoint or the package's bin links.
  if [[ ${LUNAOS_PATH:-} != /* || $(/usr/bin/realpath -e -- "$LUNAOS_PATH") != "$LUNAOS_PATH" ]] ||
    ! { [[ $command_source == "$LUNAOS_PATH/bin/$command_name" ]] ||
      [[ $LUNAOS_PATH == "/usr/share/lunaos" && $command_source == "/usr/bin/$command_name" ]]; }; then
    echo "LUNAOS_PATH does not match this LunaOS command." >&2
    return 1
  fi
}

lunaos_security_sudo_supports_no_update() {
  local help
  help=$(LC_ALL=C /usr/bin/sudo -h 2>&1) || return 1
  /usr/bin/grep -Eq '^usage: sudo .*\[[^]]*N[^]]*\]' <<< "$help"
}

lunaos_security_revoke_sudo_timestamp() {
  /usr/bin/sudo -k
}

lunaos_security_exit_with_revoked_sudo() {
  local status=$1
  local message=${2:-Could not invalidate cached sudo authorization.}

  trap - EXIT HUP INT TERM
  if ! lunaos_security_revoke_sudo_timestamp; then
    echo "$message" >&2
    (( status != 0 )) || status=1
  fi
  exit "$status"
}

lunaos_security_install_signal_exit_traps() {
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
}

lunaos_security_install_sudo_cleanup_traps() {
  LUNAOS_SECURITY_SUDO_CLEANUP_MESSAGE=${1:-Could not invalidate cached sudo authorization.}
  trap lunaos_security_run_sudo_cleanup_trap EXIT
  lunaos_security_install_signal_exit_traps
}

lunaos_security_enable_no_update_sudo() {
  local wrapper_dir="$LUNAOS_PATH/default/lunaos/sudo-no-update"
  if ! lunaos_security_sudo_supports_no_update; then
    echo "This sudo does not support --no-update; refusing mixed-trust work." >&2
    return 1
  fi
  if [[ ! -f $wrapper_dir/sudo || ! -x $wrapper_dir/sudo ]]; then
    echo "The command-scoped sudo wrapper is missing." >&2
    return 1
  fi
  PATH="$wrapper_dir:$LUNAOS_PATH/bin:/usr/bin:/usr/sbin:/bin:/sbin"
  LUNAOS_SUDO_NO_UPDATE=1
  export PATH LUNAOS_SUDO_NO_UPDATE
}

lunaos_security_run_sudo_cleanup_trap() {
  local status=$?

  lunaos_security_exit_with_revoked_sudo "$status" \
    "${LUNAOS_SECURITY_SUDO_CLEANUP_MESSAGE:-Could not invalidate cached sudo authorization.}"
}

lunaos_security_assert_root_directory() {
  local path=$1 expected_mode=$2 canonical owner actual_mode

  [[ $path == /* && -d $path && ! -L $path ]] || return 1
  canonical=$(/usr/bin/realpath -e -- "$path") || return 1
  [[ $canonical == "$path" ]] || return 1
  read -r owner actual_mode < <(/usr/bin/stat -Lc '%u %a' -- "$path") || return 1
  [[ $owner == "0" && $actual_mode == "$expected_mode" ]]
}

lunaos_security_prepare_private_root_directory() {
  local path=$1 parent=$2

  lunaos_security_assert_root_directory "$parent" 755 || return 1
  if [[ -e $path || -L $path ]]; then
    lunaos_security_assert_root_directory "$path" 700
  else
    /usr/bin/install -d -o root -g root -m 0700 -- "$path" || return 1
    lunaos_security_assert_root_directory "$path" 700
  fi
}
