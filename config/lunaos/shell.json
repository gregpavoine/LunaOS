{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "bottom",
    "background": "opaque",
    "layout": {
      "left": [
        {
          "id": "lunaos.menu"
        },
        {
          "id": "lunaos.workspaces"
        }
      ],
      "centerBegin": [
        {
          "id": "lunaos.indicators"
        }
      ],
      "center": [
        {
          "id": "lunaos.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n\u2014\nmm"
        }
      ],
      "centerEnd": [
        {
          "id": "lunaos.elsewhen"
        },
        {
          "id": "lunaos.weather"
        },
        {
          "id": "lunaos.system-update"
        }
      ],
      "right": [
        {
          "id": "lunaos.tray"
        },
        {
          "id": "lunaos.keyboard-layout"
        },
        {
          "id": "lunaos.agents"
        },
        {
          "id": "lunaos.bluetooth"
        },
        {
          "id": "lunaos.network"
        },
        {
          "id": "lunaos.audio"
        },
        {
          "id": "lunaos.monitor"
        },
        {
          "id": "lunaos.power"
        }
      ]
    }
  },
  "dock": {
    "position": "bottom",
    "pinned": [
      "org.gnome.Nautilus",
      "chromium",
      "foot",
      "omawrite",
      "X",
      "YouTube"
    ]
  },
  "plugins": []
}
